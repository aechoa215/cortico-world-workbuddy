{
  "name": "cortico-world-workbuddy",
  "version": "0.3.5",
  "type": "module",
  "description": "仅用于桌宠 Coo 的文字对话：按需调用本机已登录的 WorkBuddy 模型，读取本机登录态，列出模型目录与默认积分倍率；不提供 API、不代理其它应用。",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "workbuddy",
    "desktop-pet"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "WorkBuddy 桥接",
    "icon": "assets/icon.svg",
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "tags": [
      "unofficial-api",
      "external-setup",
      "sensitive-data"
    ],
    "os": [
      "win32"
    ],
    "locales": {
      "zh": {
        "displayName": "WorkBuddy 桥接",
        "description": "把本机已登录的 WorkBuddy 客户端模型接入 Coopanion，面板中可选模型并显示其默认积分倍率。"
      },
      "en": {
        "displayName": "WorkBuddy Bridge",
        "description": "Bridge locally signed-in WorkBuddy desktop models into Coopanion, with a model picker showing each model's default credit multiplier."
      }
    }
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "describe.json",
    "scripts",
    "!scripts/visual",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "selfcheck": "node scripts/selfcheck.mjs",
    "verify": "node scripts/verify-ui.mjs --runs 3",
    "prepack": "node scripts/build-web.mjs --strict",
    "gen:describe": "node scripts/gen-describe.mjs",
    "contract": "node scripts/contract.mjs"
  },
  "author": {
    "name": "大肥鱼 (aechoa215)",
    "email": "yawenpeng0831@gmail.com",
    "url": "https://github.com/aechoa215"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aechoa215/cortico-world-workbuddy.git"
  },
  "homepage": "https://github.com/aechoa215/cortico-world-workbuddy#readme",
  "bugs": {
    "url": "https://github.com/aechoa215/cortico-world-workbuddy/issues"
  },
  "os": [
    "win32"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
